# Public URL of the site, used for canonical links, Open Graph, sitemap and e-mail links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. Local values come from `pnpm exec supabase status`.
# The browser never talks to Supabase directly, so none of these are exposed to the client.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Secret used to derive each appointment's manage link (HMAC-SHA256). At least 32 characters.
# Rotating it invalidates every link already sent to patients.
MANAGE_TOKEN_SECRET=generate-with-openssl-rand-hex-32

# Booking attempts allowed per client every 15 minutes.
BOOKING_RATE_LIMIT=10

# Shared secret sent by Supabase Cron (pg_cron + pg_net) to /api/cron/reminders.
# Store the same value in Supabase Vault under the name `cron_secret`.
CRON_SECRET=generate-with-openssl-rand-hex-32

# Notification channel for confirmations and reminders: `console` (development), `email` or `whatsapp`.
NOTIFICATION_CHANNEL=console

# Required when NOTIFICATION_CHANNEL=email (https://resend.com).
RESEND_API_KEY=
EMAIL_FROM="Odonto Vértice <agenda@seu-dominio.com.br>"

# Required when NOTIFICATION_CHANNEL=whatsapp (Meta WhatsApp Cloud API).
# Templates consulta_confirmada, consulta_lembrete, consulta_remarcada and consulta_cancelada
# must be approved in WhatsApp Manager with five body parameters.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
